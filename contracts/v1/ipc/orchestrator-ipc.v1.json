{
  "schemaVersion": "1.0.0",
  "transport": "windows-named-pipe",
  "pipeName": "RemNoteQuickClipper.Orchestrator.v1",
  "endpoint": "\\\\.\\pipe\\RemNoteQuickClipper.Orchestrator.v1",
  "serverOwnership": "orchestrator-exclusive",
  "accessControl": "current-windows-user",
  "allowedMessages": ["task-command", "task-query"],
  "inlineContentProhibited": true,
  "persistentSourceOfTruth": "job-event-sequence",
  "maxMessageBytes": 1048576,
  "framing": {
    "protocol": "utf-8-json-lines-v1",
    "requestPerConnection": 1,
    "responsePerConnection": 1,
    "delimiter": "LF",
    "acceptedDelimiter": ["LF", "CRLF"],
    "bomAllowed": false,
    "jsonNewlines": "escaped-only",
    "byteLimitExcludesDelimiter": true,
    "serverPush": false,
    "connectionMode": "unary",
    "concurrency": "multiple-connections"
  },
  "requestSchema": "../schemas/common/ipc-request.schema.json",
  "responseSchema": "../schemas/common/ipc-response.schema.json",
  "protocolErrorBehavior": "respond-when-possible-then-close"
}
