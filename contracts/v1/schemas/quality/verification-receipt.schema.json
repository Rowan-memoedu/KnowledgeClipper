{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./verification-receipt.schema.json",
  "title": "RemNote Quick Clipper Verification Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptId",
    "verificationKind",
    "status",
    "profile",
    "candidate",
    "contractCheckpoint",
    "subject",
    "startedAt",
    "finishedAt",
    "checks",
    "evidence",
    "privacy"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "receiptId": { "$ref": "../common/artifact.schema.json#/$defs/identifier" },
    "verificationKind": {
      "type": "string",
      "enum": ["contract-fixtures", "worker-canary", "desktop-canary", "end-to-end"]
    },
    "status": { "type": "string", "enum": ["passed", "failed"] },
    "profile": {
      "type": "string",
      "enum": ["parity-remnote", "cards-remnote", "cards-anki"]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestPath", "candidateHash"],
      "properties": {
        "manifestPath": {
          "allOf": [
            { "$ref": "../common/artifact.schema.json#/$defs/jobRelativePath" },
            { "pattern": "^releases/[^/]+/win-x64/release-manifest\\.v1\\.json$" }
          ]
        },
        "candidateHash": { "$ref": "../common/artifact.schema.json#/$defs/sha256" }
      }
    },
    "contractCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpointId", "receiptPath", "receiptSha256"],
      "properties": {
        "checkpointId": { "$ref": "../common/artifact.schema.json#/$defs/identifier" },
        "receiptPath": { "$ref": "../common/artifact.schema.json#/$defs/jobRelativePath" },
        "receiptSha256": { "$ref": "../common/artifact.schema.json#/$defs/sha256" }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentId", "componentVersion", "componentSha256"],
      "properties": {
        "componentId": { "$ref": "../common/artifact.schema.json#/$defs/identifier" },
        "componentVersion": { "$ref": "../common/artifact.schema.json#/$defs/semanticVersion" },
        "componentSha256": { "$ref": "../common/artifact.schema.json#/$defs/sha256" }
      }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkId", "status"],
        "properties": {
          "checkId": { "$ref": "../common/artifact.schema.json#/$defs/identifier" },
          "status": { "type": "string", "enum": ["passed", "failed"] },
          "details": { "type": "string", "minLength": 1, "maxLength": 2048 }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "../common/artifact.schema.json#/$defs/hashedFile" }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["syntheticDataOnly", "productionContentObserved", "secretsRedacted"],
      "properties": {
        "syntheticDataOnly": { "type": "boolean" },
        "productionContentObserved": { "type": "boolean" },
        "secretsRedacted": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "passed" } }, "required": ["status"] },
      "then": {
        "properties": {
          "checks": { "not": { "contains": { "properties": { "status": { "const": "failed" } }, "required": ["status"] } } }
        }
      },
      "else": {
        "properties": {
          "checks": { "contains": { "properties": { "status": { "const": "failed" } }, "required": ["status"] } }
        }
      }
    },
    {
      "if": { "properties": { "verificationKind": { "const": "end-to-end" } }, "required": ["verificationKind"] },
      "then": {
        "properties": {
          "privacy": {
            "properties": {
              "syntheticDataOnly": { "const": true },
              "productionContentObserved": { "const": false },
              "secretsRedacted": { "const": true }
            }
          }
        }
      }
    }
  ]
}
