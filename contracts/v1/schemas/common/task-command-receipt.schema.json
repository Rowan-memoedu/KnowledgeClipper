{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./task-command-receipt.schema.json",
  "title": "RemNote Quick Clipper Task Command Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "commandId", "accepted", "taskId", "operationId", "status", "timestamp", "error", "durableEventRef"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "commandId": { "$ref": "./artifact.schema.json#/$defs/identifier" },
    "accepted": { "type": "boolean" },
    "taskId": { "$ref": "./artifact.schema.json#/$defs/identifier" },
    "operationId": { "$ref": "./artifact.schema.json#/$defs/identifier" },
    "status": { "$ref": "./task-status.schema.json" },
    "timestamp": { "type": "string", "format": "date-time" },
    "error": { "oneOf": [{ "type": "null" }, { "$ref": "./worker-result.schema.json#/$defs/error" }] },
    "durableEventRef": { "oneOf": [{ "type": "null" }, { "$ref": "./artifact.schema.json#/$defs/jobRelativePath" }] }
  },
  "allOf": [
    {
      "if": { "properties": { "accepted": { "const": true } }, "required": ["accepted"] },
      "then": {
        "properties": {
          "error": { "type": "null" },
          "durableEventRef": { "$ref": "./artifact.schema.json#/$defs/jobRelativePath" }
        }
      },
      "else": { "properties": { "error": { "$ref": "./worker-result.schema.json#/$defs/error" } } }
    }
  ]
}
