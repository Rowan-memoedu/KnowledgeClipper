{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./pipeline.schema.json",
  "title": "RemNote Quick Clipper Pipeline Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planVersion", "taskId", "maxConcurrency", "stages"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "planVersion": { "$ref": "./artifact.schema.json#/$defs/semanticVersion" },
    "taskId": { "$ref": "./artifact.schema.json#/$defs/identifier" },
    "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 32 },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stageId", "workerId", "operation", "dependsOn", "inputRefs", "outputKinds", "timeoutMs", "retryPolicy", "configSnapshot", "payload"],
        "properties": {
          "stageId": { "$ref": "./artifact.schema.json#/$defs/identifier" },
          "workerId": { "$ref": "./artifact.schema.json#/$defs/identifier" },
          "operation": { "$ref": "./artifact.schema.json#/$defs/identifier" },
          "dependsOn": { "type": "array", "uniqueItems": true, "items": { "$ref": "./artifact.schema.json#/$defs/identifier" } },
          "inputRefs": { "type": "array", "items": { "$ref": "./artifact.schema.json#/$defs/artifactReference" } },
          "outputKinds": { "type": "array", "items": { "$ref": "./artifact.schema.json#/$defs/artifactKind" } },
          "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 3600000 },
          "retryPolicy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["maxAttempts", "backoffMs"],
            "properties": {
              "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10 },
              "backoffMs": { "type": "integer", "minimum": 0, "maximum": 600000 }
            }
          },
          "configSnapshot": { "type": "object" },
          "payload": { "type": "object" }
        }
      }
    }
  }
}
