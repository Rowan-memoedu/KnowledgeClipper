{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./worker-result.schema.json",
  "title": "RemNote Quick Clipper Worker Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "operationId", "taskId", "runId", "stageId", "attemptId", "worker", "contractVersion", "idempotencyKey", "status", "outputs", "error", "startedAt", "finishedAt", "warnings"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "requestId": { "$ref": "./artifact.schema.json#/$defs/identifier" },
    "operationId": { "$ref": "./artifact.schema.json#/$defs/identifier" },
    "taskId": { "$ref": "./artifact.schema.json#/$defs/identifier" },
    "runId": { "$ref": "./artifact.schema.json#/$defs/identifier" },
    "stageId": { "$ref": "./artifact.schema.json#/$defs/identifier" },
    "attemptId": { "$ref": "./artifact.schema.json#/$defs/identifier" },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "./artifact.schema.json#/$defs/identifier" },
        "version": { "$ref": "./artifact.schema.json#/$defs/semanticVersion" }
      }
    },
    "contractVersion": { "$ref": "./artifact.schema.json#/$defs/semanticVersion" },
    "idempotencyKey": { "$ref": "./artifact.schema.json#/$defs/sha256" },
    "status": { "type": "string", "enum": ["completed", "partial", "failed", "cancelled", "unknown_external_state"] },
    "outputs": { "type": "array", "items": { "$ref": "./artifact.schema.json#/$defs/artifactReference" } },
    "itemDiagnostics": { "type": "array", "items": { "$ref": "#/$defs/itemDiagnostic" } },
    "error": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/error" }] },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "warnings": { "type": "array", "items": { "type": "string", "maxLength": 1000 } },
    "sideEffects": { "type": "array", "items": { "$ref": "#/$defs/sideEffect" } },
    "metrics": { "type": "object" },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
      "then": { "properties": { "error": { "type": "null" } } }
    },
    {
      "if": { "properties": { "status": { "const": "partial" } }, "required": ["status"] },
      "then": {
        "required": ["itemDiagnostics"],
        "properties": {
          "itemDiagnostics": {
            "minItems": 2,
            "allOf": [
              { "contains": { "properties": { "status": { "const": "completed" } }, "required": ["status"] }, "minContains": 1 },
              { "contains": { "properties": { "status": { "const": "failed" } }, "required": ["status"] }, "minContains": 1 }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "enum": ["failed", "cancelled", "unknown_external_state"] } }, "required": ["status"] },
      "then": { "properties": { "outputs": { "maxItems": 0 } } }
    },
    {
      "if": { "properties": { "status": { "const": "unknown_external_state" } }, "required": ["status"] },
      "then": {
        "properties": {
          "error": {
            "allOf": [
              { "$ref": "#/$defs/error" },
              { "properties": { "retryable": { "const": false } } }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "category", "retryable", "detailsRef"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 128 },
        "category": { "type": "string", "enum": ["contract", "worker", "dependency", "transient", "resource", "manual", "effect", "cancelled", "internal"] },
        "retryable": { "type": "boolean" },
        "detailsRef": { "$ref": "./artifact.schema.json#/$defs/jobRelativePath" },
        "message": { "type": "string", "maxLength": 2000 },
        "blame": { "type": "string", "enum": ["input", "worker", "dependency", "orchestrator", "user", "unknown"] }
      }
    },
    "itemDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "status", "outputs", "error"],
      "properties": {
        "itemId": { "$ref": "./artifact.schema.json#/$defs/identifier" },
        "status": { "type": "string", "enum": ["completed", "failed", "cancelled", "unknown_external_state"] },
        "outputs": { "type": "array", "items": { "$ref": "./artifact.schema.json#/$defs/artifactReference" } },
        "error": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/error" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
          "then": { "properties": { "error": { "type": "null" } } }
        },
        {
          "if": { "properties": { "status": { "enum": ["failed", "cancelled", "unknown_external_state"] } }, "required": ["status"] },
          "then": { "properties": { "outputs": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "status": { "const": "unknown_external_state" } }, "required": ["status"] },
          "then": { "properties": { "error": { "allOf": [{ "$ref": "#/$defs/error" }, { "properties": { "retryable": { "const": false } } }] } } }
        }
      ]
    },
    "sideEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "idempotencyKey", "state"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "idempotencyKey": { "$ref": "./artifact.schema.json#/$defs/sha256" },
        "state": { "type": "string", "enum": ["none", "prepared", "committed", "verified", "failed", "unknown"] },
        "receiptRef": { "$ref": "./artifact.schema.json#/$defs/artifactReference" }
      }
    }
  }
}
