{
  "schemaVersion": "1.0.0",
  "workerId": "content.deepseek",
  "workerVersion": "0.9.1",
  "contractVersion": "1.0.0",
  "stages": [
    "content.understand-and-card"
  ],
  "inputKinds": [
    "content-input",
    "content-config-snapshot"
  ],
  "outputKinds": [
    "ocr-proofread-bundle",
    "ocr-human-resolution-bundle",
    "learning-bundle",
    "card-bundle",
    "language-practice-decision",
    "question.answer"
  ],
  "concurrency": {
    "model": "parallel",
    "maxParallelAttempts": 4
  },
  "sideEffectLevel": "local",
  "idempotencyLevel": "idempotent",
  "cancellation": {
    "protocol": "attempt-signal-file-v1",
    "supportedReasons": [
      "user_stop",
      "superseded",
      "task_cancel",
      "timeout"
    ]
  }
}
