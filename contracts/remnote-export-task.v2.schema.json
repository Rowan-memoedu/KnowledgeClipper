{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "remnote-export-task.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskPackageId", "documentTitle", "defaultSink", "target", "route", "inputs"],
  "properties": {
    "schemaVersion": { "const": "remnote-export-task.v2" },
    "taskPackageId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "documentTitle": { "type": "string", "minLength": 1, "maxLength": 180 },
    "defaultSink": { "enum": ["mcp-direct", "markdown-zip"] },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootRemId", "rootTitle", "dateRouting"],
      "properties": {
        "rootRemId": { "type": "string", "minLength": 1 },
        "rootTitle": { "type": "string", "minLength": 1 },
        "dateRouting": { "type": "boolean" }
      }
    },
    "route": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "timeZone", "localDate", "dateFormat"],
          "properties": {
            "kind": { "const": "clip-daily-route" },
            "timeZone": { "const": "Asia/Shanghai" },
            "localDate": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "dateFormat": { "const": "yyyy-MM-dd" }
          }
        },
        { "const": { "kind": "card-export" } }
      ]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "learningBundle": { "$ref": "#/$defs/fileRef" },
        "cardBundle": { "$ref": "#/$defs/fileRef" }
      },
      "anyOf": [
        { "required": ["learningBundle"] },
        { "required": ["cardBundle"] }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "route": { "properties": { "kind": { "const": "clip-daily-route" } }, "required": ["kind"] } } },
      "then": {
        "properties": {
          "target": { "properties": { "dateRouting": { "const": true } } },
          "inputs": { "required": ["learningBundle"], "not": { "required": ["cardBundle"] } }
        }
      },
      "else": {
        "properties": {
          "target": { "properties": { "dateRouting": { "const": false } } },
          "inputs": { "required": ["cardBundle"] }
        }
      }
    }
  ],
  "$defs": {
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      }
    }
  }
}
