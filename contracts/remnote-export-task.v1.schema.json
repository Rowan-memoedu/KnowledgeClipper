{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "remnote-export-task.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskPackageId", "documentTitle", "defaultSink", "target", "inputs"],
  "properties": {
    "schemaVersion": { "const": "remnote-export-task.v1" },
    "taskPackageId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "documentTitle": { "type": "string", "minLength": 1, "maxLength": 180 },
    "defaultSink": { "enum": ["mcp-direct", "markdown-zip"] },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootRemId", "rootTitle", "dateRouting"],
      "properties": {
        "rootRemId": { "type": "string", "minLength": 1 },
        "rootTitle": { "type": "string", "minLength": 1 },
        "dateRouting": { "const": false }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "learningBundle": { "$ref": "#/$defs/fileRef" },
        "cardBundle": { "$ref": "#/$defs/fileRef" }
      },
      "anyOf": [
        { "required": ["learningBundle"] },
        { "required": ["cardBundle"] }
      ]
    }
  },
  "$defs": {
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      }
    }
  }
}
