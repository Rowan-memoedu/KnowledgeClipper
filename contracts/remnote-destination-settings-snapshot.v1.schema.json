{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "remnote-destination-settings-snapshot.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "destinationType", "enabled", "target", "advanced", "secretReferences"],
  "properties": {
    "schemaVersion": { "const": "remnote-destination-settings-snapshot.v1" },
    "destinationType": { "const": "remnote" },
    "enabled": { "type": "boolean" },
    "target": {
      "type": "object", "additionalProperties": false, "required": ["rootRemId", "rootTitle"],
      "properties": { "rootRemId": { "type": ["string", "null"] }, "rootTitle": { "type": "string", "minLength": 1 } }
    },
    "advanced": {
      "type": "object", "additionalProperties": false,
      "required": ["sink", "clipRouting", "cardRouting", "timeZone", "dateFormat"],
      "properties": {
        "sink": { "enum": ["mcp-direct", "markdown-zip"] },
        "clipRouting": { "const": "clip-daily-route" }, "cardRouting": { "const": "card-export" },
        "timeZone": { "const": "Asia/Shanghai" }, "dateFormat": { "const": "yyyy-MM-dd" }
      }
    },
    "secretReferences": { "const": [] }
  }
}
