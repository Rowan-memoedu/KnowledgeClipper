{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "remnote-export-payload.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentTitle", "sink", "target", "route"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "documentTitle": { "type": "string", "minLength": 1, "maxLength": 180 },
    "sink": { "enum": ["mcp-direct", "markdown-zip"] },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootRemId", "rootTitle"],
      "properties": {
        "rootRemId": { "type": "string", "minLength": 1 },
        "rootTitle": { "type": "string", "minLength": 1 }
      }
    },
    "route": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "timeZone", "localDate", "dateFormat"],
          "properties": {
            "kind": { "const": "clip-daily-route" },
            "timeZone": { "const": "Asia/Shanghai" },
            "localDate": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "dateFormat": { "const": "yyyy-MM-dd" }
          }
        },
        {
          "const": { "kind": "card-export" }
        }
      ]
    }
  }
}
