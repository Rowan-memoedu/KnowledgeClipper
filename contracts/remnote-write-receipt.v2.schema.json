{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "remnote-write-receipt.v2",
  "oneOf": [
    { "$ref": "#/$defs/clipDaily" },
    { "$ref": "#/$defs/cardExport" }
  ],
  "$defs": {
    "common": {
      "type": "object",
      "properties": {
        "schemaVersion": { "const": "2.0.0" },
        "sink": { "const": "mcp-direct" },
        "outcome": { "enum": ["created", "already_applied", "recovered_after_uncertain_commit"] },
        "rootRemId": { "type": "string", "minLength": 1 },
        "idempotencyKey": { "type": "string", "minLength": 1 },
        "contentSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "readbackVerified": { "const": true },
        "duplicateCount": { "const": 0 },
        "imagesHandled": { "const": false }
      }
    },
    "clipDaily": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion", "sink", "route", "outcome", "rootRemId", "rootTitle", "rootOutcome",
            "dateRemId", "dateTitle", "dateOutcome", "timeZone", "localDate", "dateFormat",
            "clipRemId", "clipTitle", "clipOutcome", "idempotencyKey", "contentSha256",
            "readbackVerified", "duplicateCount", "dateRouting", "imagesHandled"
          ],
          "properties": {
            "schemaVersion": {}, "sink": {}, "outcome": {}, "rootRemId": {}, "idempotencyKey": {},
            "contentSha256": {}, "readbackVerified": {}, "duplicateCount": {}, "imagesHandled": {},
            "route": { "const": "clip-daily-route" },
            "rootTitle": { "type": "string", "minLength": 1 },
            "rootOutcome": { "const": "reused" },
            "dateRemId": { "type": "string", "minLength": 1 },
            "dateTitle": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "dateOutcome": { "enum": ["created", "reused", "recovered_after_uncertain_commit"] },
            "timeZone": { "const": "Asia/Shanghai" },
            "localDate": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "dateFormat": { "const": "yyyy-MM-dd" },
            "clipRemId": { "type": "string", "minLength": 1 },
            "clipTitle": { "type": "string", "minLength": 1 },
            "clipOutcome": { "enum": ["created", "already_applied", "recovered_after_uncertain_commit"] },
            "dateRouting": { "const": true }
          }
        }
      ]
    },
    "cardExport": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion", "sink", "route", "outcome", "documentRemId", "documentTitle",
            "rootRemId", "idempotencyKey", "contentSha256", "readbackVerified", "duplicateCount",
            "dateRouting", "imagesHandled"
          ],
          "properties": {
            "schemaVersion": {}, "sink": {}, "outcome": {}, "rootRemId": {}, "idempotencyKey": {},
            "contentSha256": {}, "readbackVerified": {}, "duplicateCount": {}, "imagesHandled": {},
            "route": { "const": "card-export" },
            "documentRemId": { "type": "string", "minLength": 1 },
            "documentTitle": { "type": "string", "minLength": 1 },
            "dateRouting": { "const": false }
          }
        }
      ]
    }
  }
}
