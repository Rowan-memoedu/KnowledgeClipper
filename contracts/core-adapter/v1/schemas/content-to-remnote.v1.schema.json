{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./content-to-remnote.v1.schema.json",
  "title": "Deterministic content to RemNote exporter v1 projection",
  "$defs": {
    "inline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000,
      "pattern": "^(?!.*(?:>>|==|<<|<>|><))[^\\r\\n\\u0000-\\u001F]+$"
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "bundleId", "entries"],
      "properties": {
        "schemaVersion": { "const": "learning-bundle.v1" },
        "bundleId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "entries": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["itemId", "text"],
            "properties": {
              "itemId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
              "text": { "$ref": "#/$defs/inline" }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "bundleId", "cards"],
      "properties": {
        "schemaVersion": { "const": "card-bundle.v1" },
        "bundleId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "cards": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["cardId", "cardType", "direction", "front", "back"],
            "properties": {
              "cardId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
              "cardType": { "const": "basic" },
              "direction": { "enum": ["forward", "reverse", "bidirectional"] },
              "front": { "$ref": "#/$defs/inline" },
              "back": { "$ref": "#/$defs/inline" }
            }
          }
        }
      }
    }
  ]
}
