{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./content-to-anki.v1.schema.json",
  "title": "Deterministic content to Anki exporter v1 projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["bundle_kind", "schema_version", "bundle_id", "cards", "media"],
  "properties": {
    "bundle_kind": { "const": "CardBundle" },
    "schema_version": { "const": "1.0" },
    "bundle_id": { "type": "string", "minLength": 1 },
    "cards": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["card_id", "revision", "content_hash", "status", "deck_route_key", "note_type_key", "fields", "tags", "media_refs"],
        "properties": {
          "card_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },
          "revision": { "type": "integer", "minimum": 1 },
          "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "status": { "enum": ["ready", "unresolved"] },
          "deck_route_key": { "enum": ["question", "language.zh", "language.en", "other"] },
          "note_type_key": { "enum": ["basic_qa", "language_item", "image_qa"] },
          "fields": { "type": "object", "minProperties": 2, "additionalProperties": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "media_refs": { "type": "array", "maxItems": 0 }
        }
      }
    },
    "media": { "type": "array", "maxItems": 0 }
  }
}
