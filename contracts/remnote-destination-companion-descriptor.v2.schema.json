{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "knowledgeclipper://contracts/remnote-destination-companion-descriptor.v2",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "destinationType", "displayName", "optional", "peerDestinationTypes", "secretReferences", "settings", "routes", "fixedSemantics", "diagnostics", "publicProbe", "originalMedia"],
  "properties": {
    "schemaVersion": { "const": "remnote-destination-companion-descriptor.v2" }, "destinationType": { "const": "remnote" }, "displayName": { "const": "RemNote" }, "optional": { "const": true }, "peerDestinationTypes": { "const": ["anki"] }, "secretReferences": { "const": [] },
    "settings": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "target"],
      "properties": {
        "enabled": { "type": "object", "additionalProperties": false, "required": ["ownership", "effectiveAt"], "properties": { "ownership": { "const": "user" }, "effectiveAt": { "const": "next-task" } } },
        "target": { "type": "object", "additionalProperties": false, "required": ["rootRemIdPath", "rootTitlePath", "authority", "rootTitleRole", "changeEffectiveAt", "inFlightTaskMutation", "isolatedCanaryRequiresAuthorizedRoot", "formalRootTitle", "formalRootAllowedForCanary"], "properties": { "rootRemIdPath": { "const": "target.rootRemId" }, "rootTitlePath": { "const": "target.rootTitle" }, "authority": { "const": "rootRemId+exact-readback" }, "rootTitleRole": { "const": "readback-only-not-authority" }, "changeEffectiveAt": { "const": "next-task" }, "inFlightTaskMutation": { "const": false }, "isolatedCanaryRequiresAuthorizedRoot": { "const": true }, "formalRootTitle": { "const": "剪藏" }, "formalRootAllowedForCanary": { "const": false } } }
      }
    },
    "routes": { "type": "object", "required": ["clip", "cards"], "properties": { "clip": { "type": "object", "required": ["kind", "timeZone", "dateFormat"], "properties": { "kind": { "const": "clip-daily-route" }, "timeZone": { "const": "Asia/Shanghai" }, "dateFormat": { "const": "yyyy-MM-dd" } } }, "cards": { "type": "object", "required": ["kind", "dateRouting"], "properties": { "kind": { "const": "card-export" }, "dateRouting": { "const": false } } } } },
    "fixedSemantics": { "type": "object", "required": ["readback", "idempotency", "unknownExternalStateRetry", "automaticRetryAllowed"], "properties": { "readback": { "const": "exact" }, "idempotency": { "const": "reconcilable" }, "unknownExternalStateRetry": { "const": "manual-only" }, "automaticRetryAllowed": { "const": false } } },
    "diagnostics": { "type": "object", "additionalProperties": false, "required": ["deploymentPath", "mcpEndpoint", "workerVersion", "contractVersion"], "properties": { "deploymentPath": { "const": { "readOnly": true, "publicValue": "redacted" } }, "mcpEndpoint": { "const": { "readOnly": true, "publicValue": "loopback-local" } }, "workerVersion": { "type": "string" }, "contractVersion": { "const": "1.0.0" } } },
    "publicProbe": { "type": "object", "additionalProperties": false, "required": ["requestSchemaVersion", "resultSchemaVersion", "cli", "operations", "timeoutMs", "externalCall", "externalWriteCount", "sanitized", "connectedToolTimeoutState", "admissionOnDegraded"], "properties": { "requestSchemaVersion": { "const": "remnote-public-probe-request.v2" }, "resultSchemaVersion": { "const": "remnote-public-probe-result.v2" }, "cli": { "const": "probe-public --request <absolute-probe-request.json> --json" }, "operations": { "const": ["status", "search", "list", "read"] }, "timeoutMs": { "const": 15000 }, "externalCall": { "const": true }, "externalWriteCount": { "const": 0 }, "sanitized": { "const": true }, "connectedToolTimeoutState": { "const": "degraded" }, "admissionOnDegraded": { "const": "blocked" } } },
    "originalMedia": { "type": "object", "additionalProperties": false, "required": ["contractVersion", "ordering", "readCapability", "writeCapability", "productionStatus", "reasonCode", "silentDropAllowed"], "properties": { "contractVersion": { "const": "remnote-original-media.v2" }, "ordering": { "const": "explicit-role-ordinal" }, "readCapability": { "const": "media.images.v1" }, "writeCapability": { "type": "null" }, "productionStatus": { "const": "unsupported" }, "reasonCode": { "const": "mcp.media_write_unavailable" }, "silentDropAllowed": { "const": false } } }
  }
}
