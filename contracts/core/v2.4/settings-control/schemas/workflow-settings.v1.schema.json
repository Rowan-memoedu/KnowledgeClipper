{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-clipper-workflow-settings.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "activeProfileId", "profiles"],
  "properties": {
    "schemaVersion": { "const": "knowledge-clipper-workflow-settings.v1" },
    "activeProfileId": { "$ref": "#/$defs/id" },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "processingProfile": { "enum": ["learning", "cards"] },
        "destinations": {
          "type": "array", "maxItems": 2, "uniqueItems": true,
          "items": { "enum": ["remnote", "anki"] }
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contextEnabled": { "type": "boolean" },
        "contextGranularity": { "enum": ["sentence", "paragraph"] },
        "imageHandling": { "enum": ["ocr", "original"] }
      }
    },
    "speech": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "voicesByLanguage": {
          "type": "object", "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z]{2}-[A-Z]{2}$" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "ratePercent": { "type": "integer", "minimum": -100, "maximum": 100 },
        "volumePercent": { "type": "integer", "minimum": -100, "maximum": 100 },
        "pitchHz": { "type": "integer", "minimum": -100, "maximum": 100 },
        "autoPlay": { "type": "boolean" }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "workflow": { "$ref": "#/$defs/workflow" },
        "capture": { "$ref": "#/$defs/capture" },
        "speech": { "$ref": "#/$defs/speech" },
        "remnote": { "$ref": "../../../../remnote-destination-settings.v1.schema.json" }
      }
    }
  }
}
