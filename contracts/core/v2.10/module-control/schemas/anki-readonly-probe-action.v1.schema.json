{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anki-readonly-probe-action.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "packageRootRef", "configRef", "effectClass", "externalMutation"],
  "properties": {
    "schemaVersion": {"const": "anki-readonly-probe-action.v1"},
    "taskId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "packageRootRef": {"type": "string", "pattern": "^module-actions/[A-Za-z0-9][A-Za-z0-9._-]{0,127}/package$"},
    "configRef": {
      "allOf": [
        {"$ref": "../../../../v1/schemas/common/artifact.schema.json#/$defs/artifactReference"},
        {"properties": {"kind": {"const": "anki-export-config"}, "contractVersion": {"const": "1.0.0"}}}
      ]
    },
    "effectClass": {"const": "provider-read-only"},
    "externalMutation": {"const": false}
  }
}
