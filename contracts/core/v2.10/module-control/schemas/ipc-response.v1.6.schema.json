{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-clipper-ipc-response.v1.6",
  "type": "object", "additionalProperties": false,
  "required": ["protocolVersion", "correlationId", "messageType", "ok", "payload", "error"],
  "properties": {
    "protocolVersion": {"enum": ["1.0", "1.1", "1.2", "1.3", "1.4", "1.5", "1.6"]},
    "correlationId": {"type": "string"},
    "messageType": {"enum": ["task-command-receipt", "task-query-result", "stage-control-receipt", "module-action-receipt", "protocol-error"]},
    "ok": {"type": "boolean"},
    "payload": {"type": ["object", "null"]},
    "error": {"type": ["object", "null"]}
  },
  "allOf": [
    {"if": {"properties": {"messageType": {"const": "module-action-receipt"}}, "required": ["messageType"]}, "then": {"properties": {"protocolVersion": {"const": "1.6"}, "ok": {"const": true}, "payload": {"$ref": "./module-action-receipt.v5.schema.json"}, "error": {"type": "null"}}}}
  ]
}
