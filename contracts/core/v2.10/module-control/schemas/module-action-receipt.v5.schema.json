{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-clipper-module-action-receipt.v5",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "actionId", "operation", "accepted", "status", "inputRef", "inputSha256", "externalWriteCount", "physicalAudio", "automaticRetryAllowed", "idempotencyKey", "completedAt"],
  "properties": {
    "schemaVersion": {"const": "knowledge-clipper-module-action-receipt.v5"},
    "actionId": {"type": "string", "minLength": 1},
    "operation": {"enum": ["content.settings.describe", "content.settings.copy", "content.settings.validate", "content.settings.diff"]},
    "accepted": {"type": "boolean"},
    "status": {"enum": ["completed", "failed", "unknown_external_state"]},
    "inputRef": {"type": "string"},
    "inputSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "outputRef": {"type": ["string", "null"]},
    "outputSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "catalogSnapshotRef": {"type": "null"},
    "catalogSnapshotSha256": {"type": "null"},
    "externalWriteCount": {"const": 0},
    "physicalAudio": {"const": false},
    "automaticRetryAllowed": {"const": false},
    "idempotencyKey": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "completedAt": {"type": "string", "format": "date-time"},
    "error": {"type": ["object", "null"]},
    "executionStatus": {"enum": ["completed", "failed", "unknown_external_state"]},
    "taskId": {"type": "null"},
    "runId": {"type": "null"},
    "artifactRootRef": {"type": "null"},
    "outputRefs": {
      "type": "array", "maxItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["referenceType", "kind", "contractVersion", "rootRef", "path", "expectedSha256"],
        "properties": {
          "referenceType": {"const": "file"},
          "kind": {"enum": ["content-settings-description", "content-settings-copy-result", "content-settings-validation", "content-settings-diff"]},
          "contractVersion": {"const": "1.0.0"},
          "rootRef": {"const": "jobs-root"},
          "path": {"type": "string", "pattern": "^module-actions/.+/result\\.json$"},
          "expectedSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"accepted": {"const": true}}, "required": ["accepted"]}, "then": {"required": ["outputRef", "outputSha256", "executionStatus", "outputRefs"], "properties": {"status": {"const": "completed"}, "executionStatus": {"const": "completed"}, "outputRef": {"type": "string"}, "outputSha256": {"type": "string"}, "outputRefs": {"minItems": 1}, "error": {"type": "null"}}}},
    {"if": {"properties": {"accepted": {"const": false}}, "required": ["accepted"]}, "then": {"required": ["error", "executionStatus", "outputRefs"], "properties": {"status": {"enum": ["failed", "unknown_external_state"]}, "outputRef": {"type": "null"}, "outputSha256": {"type": "null"}, "outputRefs": {"maxItems": 0}, "error": {"type": "object"}}}}
  ]
}
