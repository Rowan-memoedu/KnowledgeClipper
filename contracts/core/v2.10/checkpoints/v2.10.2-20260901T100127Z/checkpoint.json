  "desktopMigrationInput": [
    "Migrate DesktopModuleSettingsHost speech.voices, speech.preview, and remnote.probe from IPC 1.2/module-action v1 to IPC 1.7/module-action v6.",
    "For RemNote probe, continue using only the persisted or verified-pending exact target and the fixed status/search/list/read sequence; verify the returned typed result SHA before projecting readiness.",
    "For voice discovery, keep it read-only and never route settings open/save/status to preview.",
    "Wrap preview worker input in speech-settings-speaker-preview-action.v2 and bind explicit-user-action authorization to actionId, previewLanguage, and authorizedAt.",
    "Treat receipt.executionStatus separately from receipt.status and never auto-retry preview failed/unknown outcomes.",
    "This checkpoint was validated with Fake/offline preview only; Desktop physical preview remains a separate explicit human test gate."
  ],
  "qualityAuditInput": [
    "Independently re-hash every fileBinding and rerun formal Core process IPC 1.7; do not trust this checkpoint status.",
    "Verify RemNote operations cannot exceed status/search/list/read and externalWriteCount remains zero for healthy/degraded/blocked typed results.",
    "Verify Speech voices cannot mutate settings or play audio.",
    "Verify preview authorization drift creates no receipt and no worker result, while authorized Fake/offline preview produces one typed SHA-bound result and no physical speaker invocation.",
    "Do not promote to integrated candidate without separate Desktop and Quality PASS."
  ],
