{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kc.query/2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "queryId", "projection", "consistency", "parameters"],
  "properties": {
    "schema": {"const": "kc.query/2"},
    "queryId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "projection": {"type": "string", "minLength": 1},
    "subject": {"type": ["object", "null"]},
    "consistency": {"enum": ["eventual", "read-your-writes"]},
    "cursor": {"type": ["integer", "null"], "minimum": 0},
    "parameters": {"type": "object"}
  }
}
