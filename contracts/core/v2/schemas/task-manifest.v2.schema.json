{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./task-manifest.v2.schema.json",
  "title": "KnowledgeClipper destination-neutral task manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskId", "createdAt", "createdBy", "intent", "executionProfile", "destinations", "inputRefs", "requestedOutputs", "initialPlanRef", "retentionClass"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "taskId": { "$ref": "../../../v1/schemas/common/artifact.schema.json#/$defs/identifier" },
    "createdAt": { "type": "string", "format": "date-time" },
    "createdBy": {
      "type": "object", "additionalProperties": false, "required": ["application", "version"],
      "properties": { "application": { "type": "string", "minLength": 1 }, "version": { "$ref": "../../../v1/schemas/common/artifact.schema.json#/$defs/semanticVersion" } }
    },
    "intent": { "enum": ["clip.card", "clip.write", "clip.read-aloud", "clip.question"] },
    "executionProfile": { "enum": ["learning", "cards"] },
    "destinations": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "enum": ["remnote", "anki"] } },
    "inputRefs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["artifactRef", "kind", "contractVersion", "expectedSha256"],
        "properties": {
          "artifactRef": { "$ref": "../../../v1/schemas/common/artifact.schema.json#/$defs/identifier" },
          "kind": { "$ref": "../../../v1/schemas/common/artifact.schema.json#/$defs/artifactKind" },
          "contractVersion": { "$ref": "../../../v1/schemas/common/artifact.schema.json#/$defs/semanticVersion" },
          "expectedSha256": { "$ref": "../../../v1/schemas/common/artifact.schema.json#/$defs/sha256" }
        }
      }
    },
    "requestedOutputs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "../../../v1/schemas/common/artifact.schema.json#/$defs/artifactKind" } },
    "initialPlanRef": { "$ref": "../../../v1/schemas/common/artifact.schema.json#/$defs/jobRelativePath" },
    "retentionClass": { "enum": ["ephemeral", "standard", "evidence", "pinned"] },
    "metadata": { "type": "object" }
  }
}
