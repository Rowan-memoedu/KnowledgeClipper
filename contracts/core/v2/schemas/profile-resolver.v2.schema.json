{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./profile-resolver.v2.schema.json",
  "title": "KnowledgeClipper destination-neutral profile resolver v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defaultProcessingProfile", "processingProfiles", "defaultDestinations", "destinations", "legacyProfileAliases", "destinationConfigurations", "speech"],
  "properties": {
    "schemaVersion": { "const": "knowledge-clipper-profile-resolver.v2" },
    "defaultProcessingProfile": { "enum": ["learning", "cards"] },
    "processingProfiles": { "const": ["learning", "cards"] },
    "defaultDestinations": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "enum": ["remnote", "anki"] } },
    "destinations": { "const": ["remnote", "anki"] },
    "legacyProfileAliases": {
      "type": "object", "additionalProperties": false,
      "required": ["parity-remnote", "cards-remnote", "cards-anki"],
      "properties": {
        "parity-remnote": { "$ref": "#/$defs/learningRemnoteAlias" },
        "cards-remnote": { "$ref": "#/$defs/cardsRemnoteAlias" },
        "cards-anki": { "$ref": "#/$defs/cardsAnkiAlias" }
      }
    },
    "destinationConfigurations": {
      "type": "object", "additionalProperties": false, "required": ["remnote", "anki"],
      "properties": {
        "remnote": {
          "type": "object", "additionalProperties": false, "required": ["export", "projection"],
          "properties": {
            "export": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object", "additionalProperties": false, "required": ["sink", "rootRemId", "rootTitle", "documentTitlePrefix"],
                  "properties": {
                    "sink": { "enum": ["mcp-direct", "markdown-zip"] },
                    "rootRemId": { "type": "string", "minLength": 1 },
                    "rootTitle": { "type": "string", "minLength": 1 },
                    "documentTitlePrefix": { "type": "string", "minLength": 1, "maxLength": 100 }
                  }
                }
              ]
            },
            "projection": { "$ref": "#/$defs/remnoteProjection" }
          }
        },
        "anki": {
          "type": "object", "additionalProperties": false, "required": ["projection"],
          "properties": { "projection": { "$ref": "#/$defs/ankiProjection" } }
        }
      }
    },
    "speech": { "$ref": "#/$defs/speech" }
  },
  "$defs": {
    "learningRemnoteAlias": { "const": { "processingProfile": "learning", "destinations": ["remnote"] } },
    "cardsRemnoteAlias": { "const": { "processingProfile": "cards", "destinations": ["remnote"] } },
    "cardsAnkiAlias": { "const": { "processingProfile": "cards", "destinations": ["anki"] } },
    "remnoteProjection": {
      "type": "object", "additionalProperties": false,
      "required": ["categoryRegistryVersion", "templateMappings", "allowedTextBlockTypes", "blockRendering", "assetRefPolicy"],
      "properties": {
        "categoryRegistryVersion": { "const": "category-registry/1.0.0" },
        "templateMappings": {
          "type": "object", "additionalProperties": false,
          "required": ["basic_qa", "media_qa", "language_context", "concept_transfer", "procedure"],
          "properties": {
            "basic_qa": { "$ref": "#/$defs/remnoteProject" },
            "media_qa": { "$ref": "#/$defs/remnoteReject" },
            "language_context": { "$ref": "#/$defs/remnoteProject" },
            "concept_transfer": { "$ref": "#/$defs/remnoteProject" },
            "procedure": { "$ref": "#/$defs/remnoteProject" }
          }
        },
        "allowedTextBlockTypes": { "const": ["text", "markdown"] },
        "blockRendering": { "const": "single-block-verbatim-inline" },
        "assetRefPolicy": { "const": "reject-media-deferred" }
      }
    },
    "remnoteProject": {
      "type": "object", "additionalProperties": false, "required": ["policy", "cardType", "direction"],
      "properties": { "policy": { "const": "project" }, "cardType": { "const": "basic" }, "direction": { "enum": ["forward", "reverse", "bidirectional"] } }
    },
    "remnoteReject": {
      "type": "object", "additionalProperties": false, "required": ["policy", "cardType", "direction"],
      "properties": { "policy": { "const": "reject-media-deferred" }, "cardType": { "type": "null" }, "direction": { "type": "null" } }
    },
    "ankiProjection": {
      "type": "object", "additionalProperties": false,
      "required": ["categoryRegistryVersion", "categoryToDeckRoute", "templateMappings", "revisionPolicy", "contentHashPolicy", "tags", "assetRefPolicy"],
      "properties": {
        "categoryRegistryVersion": { "const": "category-registry/1.0.0" },
        "categoryToDeckRoute": {
          "const": { "question_answer": "question", "language_zh": "language.zh", "language_en": "language.en", "general_learning": "other" }
        },
        "templateMappings": {
          "type": "object", "additionalProperties": false,
          "required": ["basic_qa", "media_qa", "language_context", "concept_transfer", "procedure"],
          "properties": {
            "basic_qa": { "$ref": "#/$defs/ankiBasic" },
            "media_qa": { "$ref": "#/$defs/ankiReject" },
            "language_context": { "$ref": "#/$defs/ankiLanguage" },
            "concept_transfer": { "$ref": "#/$defs/ankiBasic" },
            "procedure": { "$ref": "#/$defs/ankiBasic" }
          }
        },
        "revisionPolicy": { "const": "initial-revision-1" },
        "contentHashPolicy": { "const": "sha256-canonical-projection-v1" },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "assetRefPolicy": { "const": "reject-media-deferred" }
      }
    },
    "ankiBasic": {
      "const": { "policy": "project", "noteTypeKey": "basic_qa", "frontField": "question", "backField": "answer" }
    },
    "ankiLanguage": {
      "const": { "policy": "project", "noteTypeKey": "language_item", "frontField": "context_sentence", "backField": "reading_and_meaning" }
    },
    "ankiReject": {
      "const": { "policy": "reject-media-deferred", "noteTypeKey": null, "frontField": null, "backField": null }
    },
    "speech": {
      "type": "object", "additionalProperties": false,
      "required": ["voicesByLanguage", "ratePercent", "volumePercent", "pitchHz", "edgeTtsPath", "ffplayPath"],
      "properties": {
        "voicesByLanguage": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } },
        "ratePercent": { "type": "integer", "minimum": -100, "maximum": 100 },
        "volumePercent": { "type": "integer", "minimum": -100, "maximum": 100 },
        "pitchHz": { "type": "integer", "minimum": -1000, "maximum": 1000 },
        "edgeTtsPath": { "type": ["string", "null"] },
        "ffplayPath": { "type": ["string", "null"] }
      }
    }
  }
}
