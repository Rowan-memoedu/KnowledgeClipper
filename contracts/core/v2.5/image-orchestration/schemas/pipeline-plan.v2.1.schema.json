{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-clipper-pipeline-plan.v2.1",
  "title": "KnowledgeClipper image-aware destination-neutral pipeline v2.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planVersion", "taskId", "maxConcurrency", "stages", "routing"],
  "properties": {
    "schemaVersion": { "const": "2.1.0" },
    "planVersion": { "const": "2.1.0" },
    "taskId": { "$ref": "../../../../v1/schemas/common/artifact.schema.json#/$defs/identifier" },
    "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 32 },
    "routing": {
      "type": "object", "additionalProperties": false,
      "required": ["processingProfile", "destinations", "source"],
      "properties": {
        "processingProfile": { "enum": ["learning", "cards"] },
        "destinations": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "enum": ["remnote", "anki"] } },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "stages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["stageId", "workerId", "operation", "dependsOn", "inputRefs", "outputKinds", "timeoutMs", "retryPolicy", "configSnapshot", "payload", "inputBindings"],
        "properties": {
          "stageId": { "$ref": "../../../../v1/schemas/common/artifact.schema.json#/$defs/identifier" },
          "workerId": { "$ref": "../../../../v1/schemas/common/artifact.schema.json#/$defs/identifier" },
          "operation": { "$ref": "../../../../v1/schemas/common/artifact.schema.json#/$defs/identifier" },
          "dependsOn": { "type": "array", "uniqueItems": true, "items": { "$ref": "../../../../v1/schemas/common/artifact.schema.json#/$defs/identifier" } },
          "inputRefs": { "type": "array", "items": { "$ref": "../../../../v1/schemas/common/artifact.schema.json#/$defs/artifactReference" } },
          "outputKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "../../../../v1/schemas/common/artifact.schema.json#/$defs/artifactKind" } },
          "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 3600000 },
          "retryPolicy": {
            "type": "object", "additionalProperties": false, "required": ["maxAttempts", "backoffMs"],
            "properties": { "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10 }, "backoffMs": { "type": "integer", "minimum": 0, "maximum": 600000 } }
          },
          "partialRetryPolicy": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object", "additionalProperties": false,
                "required": ["strategy", "maxContinuationAttempts"],
                "properties": { "strategy": { "const": "failed-items-only" }, "maxContinuationAttempts": { "type": "integer", "minimum": 1, "maximum": 9 } }
              }
            ]
          },
          "configSnapshot": { "type": "object" },
          "payload": { "type": "object" },
          "inputBindings": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["fromStageId", "kind", "required"],
              "properties": {
                "fromStageId": { "$ref": "../../../../v1/schemas/common/artifact.schema.json#/$defs/identifier" },
                "kind": { "$ref": "../../../../v1/schemas/common/artifact.schema.json#/$defs/artifactKind" },
                "required": { "type": "boolean" }
              }
            }
          },
          "inputAdapter": { "type": ["object", "null"] },
          "completionPolicy": { "type": ["object", "null"] }
        }
      }
    },
    "terminalBoundary": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["status", "code", "availableOutputKinds", "unsupportedConsumers"],
          "properties": {
            "status": { "const": "unsupported" },
            "code": { "const": "media.downstream_unsupported" },
            "availableOutputKinds": { "const": ["image.original"] },
            "unsupportedConsumers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "required": ["terminalBoundary"], "properties": { "terminalBoundary": { "type": "object" } } },
      "then": {
        "properties": {
          "stages": {
            "maxItems": 1,
            "items": {
              "properties": {
                "workerId": { "const": "image.ocr.mineru" },
                "operation": { "const": "process-images" },
                "outputKinds": { "const": ["image.original"] },
                "partialRetryPolicy": { "type": ["null"] }
              }
            }
          }
        }
      }
    }
  ]
}
