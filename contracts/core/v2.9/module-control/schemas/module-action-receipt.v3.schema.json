{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-clipper-module-action-receipt.v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "actionId", "operation", "accepted", "status", "inputRef", "inputSha256", "outputRef", "outputSha256", "catalogSnapshotRef", "catalogSnapshotSha256", "externalWriteCount", "physicalAudio", "automaticRetryAllowed", "idempotencyKey", "completedAt", "error"],
  "properties": {
    "schemaVersion": {"const": "knowledge-clipper-module-action-receipt.v3"},
    "actionId": {"type": "string", "minLength": 1},
    "operation": {"enum": ["speech.voices", "speech.preview", "remnote.probe", "remnote.discover-target", "anki.initialize-managed"]},
    "accepted": {"type": "boolean"},
    "status": {"enum": ["ready", "conditional", "completed", "initialized", "already_current", "failed", "unknown_external_state", "blocked", "degraded"]},
    "inputRef": {"type": "string"},
    "inputSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "outputRef": {"type": ["string", "null"]},
    "outputSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "catalogSnapshotRef": {"type": ["string", "null"]},
    "catalogSnapshotSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "externalWriteCount": {"type": "integer", "minimum": -1},
    "physicalAudio": {"type": "boolean"},
    "automaticRetryAllowed": {"const": false},
    "idempotencyKey": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "completedAt": {"type": "string", "format": "date-time"},
    "error": {"type": ["object", "null"]}
  },
  "allOf": [
    {"if": {"properties": {"status": {"enum": ["initialized", "already_current"]}}, "required": ["status"]}, "then": {"properties": {"accepted": {"const": true}, "operation": {"const": "anki.initialize-managed"}, "externalWriteCount": {"minimum": 0}, "outputRef": {"type": "string"}, "outputSha256": {"type": "string"}, "error": {"type": "null"}}}},
    {"if": {"properties": {"status": {"const": "unknown_external_state"}}, "required": ["status"]}, "then": {"properties": {"accepted": {"const": false}, "automaticRetryAllowed": {"const": false}, "externalWriteCount": {"const": -1}, "outputRef": {"type": "null"}, "outputSha256": {"type": "null"}, "error": {"type": "object"}}}}
  ]
}
