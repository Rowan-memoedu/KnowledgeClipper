<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <DesktopAssemblyPath Condition="'$(DesktopAssemblyPath)' == ''">$(KnowledgeClipperBuildOutput)\RemNoteQuickClipper.Desktop\Release\net8.0-windows\win-x64\KnowledgeClipper.dll</DesktopAssemblyPath>
    <DesktopRuntimeDirectory>$([System.IO.Path]::GetDirectoryName('$(DesktopAssemblyPath)'))</DesktopRuntimeDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="KnowledgeClipper">
      <HintPath>$(DesktopAssemblyPath)</HintPath>
    </Reference>
    <Reference Include="KnowledgeClipper.Workflow"><HintPath>$(DesktopRuntimeDirectory)\KnowledgeClipper.Workflow.dll</HintPath></Reference>
  </ItemGroup>
</Project>
