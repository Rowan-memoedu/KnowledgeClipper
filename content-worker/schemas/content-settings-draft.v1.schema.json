{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content-settings-draft/1.0.0",
  "title": "KnowledgeClipper Content editable settings draft",
  "type": "object",
  "required": ["schemaVersion", "draftId", "basedOn", "resources", "security"],
  "properties": {
    "schemaVersion": { "const": "content-settings-draft/1.0.0" },
    "draftId": { "$ref": "#/$defs/identifier" },
    "basedOn": {
      "type": "object",
      "required": ["workerId", "workerVersion", "promptSetId", "promptSetSha256", "promptFiles", "categoryRegistryId", "categoryRegistrySha256"],
      "properties": {
        "workerId": { "const": "content.deepseek" },
        "workerVersion": { "$ref": "#/$defs/version" },
        "promptSetId": { "type": "string", "minLength": 1 },
        "promptSetSha256": { "$ref": "#/$defs/sha256" },
        "promptFiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
        "categoryRegistryId": { "type": "string", "minLength": 1 },
        "categoryRegistrySha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": ["promptRoot", "categoryRegistryPath"],
      "properties": {
        "promptRoot": { "const": "prompts" },
        "categoryRegistryPath": { "const": "config/categories.v2.json" }
      },
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "required": ["credentials", "taskPackageSecrets"],
      "properties": {
        "credentials": { "const": "process-injected-only" },
        "taskPackageSecrets": { "const": "forbidden" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "file": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
