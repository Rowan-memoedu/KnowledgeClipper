{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standard-input/1.0.0",
  "title": "Content worker module-local input document",
  "$comment": "This schema defines the entrypoint JSON inside a common content-input Artifact. It is not a common TaskManifest or WorkerRequest authority.",
  "type": "object",
  "required": ["schema_version", "package_id", "task_id", "input_version", "mode", "items"],
  "properties": {
    "schema_version": { "const": "standard-input/1.0.0" },
    "package_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "input_version": { "type": "string", "minLength": 1 },
    "mode": { "const": "card" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item_id", "source"],
        "properties": {
          "item_id": { "type": "string", "minLength": 1 },
          "source": {
            "oneOf": [
              {
                "type": "object",
                "required": ["kind", "material_path"],
                "properties": { "kind": { "enum": ["text", "conversation"] }, "material_path": { "type": "string", "minLength": 1 } },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["kind", "assets"],
                "properties": {
                  "kind": { "const": "media_set" },
                  "assets": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["material_path", "role"],
                      "properties": {
                        "material_path": { "type": "string", "minLength": 1 },
                        "role": { "enum": ["question", "answer", "context", "unknown"] }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "hints": { "type": "object", "additionalProperties": true },
          "human_overrides": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
