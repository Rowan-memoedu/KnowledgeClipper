{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standard-input/6.0.0",
  "title": "Language selection with exact target and ordered context",
  "type": "object",
  "required": ["schema_version", "package_id", "task_id", "input_version", "mode", "items"],
  "properties": {
    "schema_version": { "const": "standard-input/6.0.0" },
    "package_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "input_version": { "type": "string", "minLength": 1 },
    "mode": { "const": "card" },
    "languagePracticeMode": { "enum": ["meaning-reading", "writing", "both"] },
    "human_overrides": { "type": "object" },
    "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["item_id", "source", "language_selection"],
      "properties": {
        "item_id": { "type": "string", "minLength": 1 },
        "source": { "type": "object", "required": ["kind", "material_path"], "properties": { "kind": { "const": "text" }, "material_path": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
        "hints": { "type": "object" },
        "human_overrides": { "type": "object" },
        "language_selection": {
          "type": "object",
          "required": ["schema_version", "selected_text", "selected_text_sha256", "target_text", "target_text_sha256", "context_enabled", "context_segments"],
          "properties": {
            "schema_version": { "const": "language-selection/1.0.0" },
            "selected_text": { "type": "string", "minLength": 1 },
            "selected_text_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "target_text": { "type": "string", "minLength": 1 },
            "target_text_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "context_enabled": { "type": "boolean" },
            "context_segments": { "type": "array", "items": { "type": "object", "required": ["segment_id", "order", "material_path", "sha256"], "properties": { "segment_id": { "type": "string", "minLength": 1 }, "order": { "type": "integer", "minimum": 0 }, "material_path": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }, "additionalProperties": false } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
