{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "legacy-content-task-manifest.v0",
  "title": "Legacy content-worker package manifest, migration evidence only",
  "$comment": "Runtime common CLI does not read this schema. The authority is contracts/v1/schemas/common/artifact.schema.json plus worker-request.schema.json.",
  "type": "object",
  "required": ["schema_version", "package_id", "package_version", "created_at", "files"],
  "properties": {
    "schema_version": { "const": "task-manifest/1.0.0" },
    "package_id": { "type": "string", "minLength": 1 },
    "package_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size", "media_type"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": { "type": "integer", "minimum": 0 },
          "media_type": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
