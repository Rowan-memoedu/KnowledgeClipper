{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standard-input/2.0.0",
  "title": "KnowledgeClipper content worker module-local input v2",
  "$comment": "Adds versioned languagePracticeMode and human-confirmed writing details without changing common WorkerRequest authority.",
  "type": "object",
  "required": ["schema_version", "package_id", "task_id", "input_version", "mode", "items"],
  "properties": {
    "schema_version": { "const": "standard-input/2.0.0" },
    "package_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "input_version": { "type": "string", "minLength": 1 },
    "mode": { "const": "card" },
    "languagePracticeMode": { "enum": ["meaning-reading", "writing", "both"] },
    "human_overrides": {
      "$ref": "#/$defs/humanOverrides"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item_id", "source"],
        "properties": {
          "item_id": { "type": "string", "minLength": 1 },
          "source": {
            "oneOf": [
              {
                "type": "object",
                "required": ["kind", "material_path"],
                "properties": {
                  "kind": { "enum": ["text", "conversation"] },
                  "material_path": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["kind", "assets"],
                "properties": {
                  "kind": { "const": "media_set" },
                  "assets": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["material_path", "role"],
                      "properties": {
                        "material_path": { "type": "string", "minLength": 1 },
                        "role": { "enum": ["question", "answer", "context", "unknown"] }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "hints": {
            "type": "object",
            "properties": {
              "languagePracticeMode": { "enum": ["meaning-reading", "writing", "both"] }
            },
            "additionalProperties": true
          },
          "human_overrides": { "$ref": "#/$defs/humanOverrides" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "humanOverrides": {
      "type": "object",
      "properties": {
        "languagePracticeMode": { "enum": ["meaning-reading", "writing", "both"] },
        "languageWriting": {
          "type": "object",
          "required": ["units"],
          "properties": {
            "units": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["pronunciation", "meaning", "confirmed"],
                "properties": {
                  "pronunciation": { "type": "string", "minLength": 1 },
                  "meaning": { "type": "string", "minLength": 1 },
                  "confirmed": { "const": true }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
