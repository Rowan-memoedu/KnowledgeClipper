{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learning-bundle/2.0.0",
  "type": "object",
  "required": ["schema_version", "bundle_id", "package_id", "task_id", "input_version", "attempt_id", "created_at", "input", "ocr_proofread_bundle_path", "ocr_proofread_bundle_sha256", "worker", "items", "ai_trace", "release_state", "unresolved_items", "gates"],
  "properties": {
    "schema_version": { "const": "learning-bundle/2.0.0" },
    "bundle_id": { "type": "string", "minLength": 1 },
    "package_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "input_version": { "type": "string", "minLength": 1 },
    "attempt_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "input": { "type": "object" },
    "ocr_proofread_bundle_path": { "type": "string", "minLength": 1 },
    "ocr_proofread_bundle_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "worker": { "type": "object" },
    "items": { "type": "array", "minItems": 1 },
    "ai_trace": { "type": "array" },
    "release_state": { "enum": ["ready", "partial", "unresolved", "failed"] },
    "unresolved_items": { "type": "array" },
    "gates": { "type": "array" }
  },
  "additionalProperties": false
}
