{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standard-input/5.0.0",
  "title": "Content worker OCR human-resolution input snapshot",
  "$comment": "Additive module-local schema produced by Core after a validated resume command. It binds the original OCR, frozen unresolved proofread artifact and user action by SHA-256.",
  "type": "object",
  "required": ["schema_version", "package_id", "task_id", "input_version", "mode", "items"],
  "properties": {
    "schema_version": { "const": "standard-input/5.0.0" },
    "package_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "input_version": { "type": "string", "minLength": 1 },
    "mode": { "const": "card" },
    "languagePracticeMode": { "enum": ["meaning-reading", "writing", "both"] },
    "human_overrides": { "type": "object", "additionalProperties": true },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item_id", "source", "ocr_human_resolution"],
        "properties": {
          "item_id": { "type": "string", "minLength": 1 },
          "source": { "$ref": "#/$defs/ocrSource" },
          "hints": { "type": "object", "additionalProperties": true },
          "human_overrides": { "type": "object", "additionalProperties": true },
          "ocr_human_resolution": { "$ref": "#/$defs/resolution" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "required": ["artifactRef", "kind", "contractVersion", "manifestPath", "expectedSha256", "payload_path", "payload_sha256"],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "contractVersion": { "const": "1.0.0" },
        "manifestPath": { "type": "string", "minLength": 1 },
        "expectedSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "payload_path": { "type": "string", "minLength": 1 },
        "payload_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "ocrSource": {
      "type": "object",
      "required": ["kind", "material_path", "provenance"],
      "properties": {
        "kind": { "const": "ocr_text" },
        "material_path": { "type": "string", "minLength": 1 },
        "provenance": {
          "type": "object",
          "required": ["schema_version", "producer_worker_id", "markdown_artifact"],
          "properties": {
            "schema_version": { "const": "ocr-provenance/1.0.0" },
            "producer_worker_id": { "const": "image.ocr.mineru" },
            "markdown_artifact": { "$ref": "#/$defs/artifactRef" },
            "structured_artifact": { "$ref": "#/$defs/artifactRef" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "unresolved": {
      "type": "object",
      "required": ["segment_index", "start", "end", "exact_text", "reason", "evidence"],
      "properties": {
        "segment_index": { "type": "integer", "minimum": 0 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 },
        "exact_text": { "type": "string", "minLength": 1 },
        "reason": { "enum": ["ambiguous_text", "insufficient_context", "protected_content", "structural_ambiguity"] },
        "evidence": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "diff": {
      "type": "object",
      "required": ["segment_index", "operation", "start", "end", "before", "after"],
      "properties": {
        "segment_index": { "type": "integer", "minimum": 0 },
        "operation": { "enum": ["substitution", "insertion", "deletion"] },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "before": { "type": "string" },
        "after": { "type": "string" }
      },
      "additionalProperties": false
    },
    "resolution": {
      "type": "object",
      "required": ["schema_version", "resolution_id", "action", "source_proofread_artifact", "source_item_id", "original_text_sha256", "proofread_text_sha256", "unresolved_candidates", "reason"],
      "properties": {
        "schema_version": { "const": "ocr-human-resolution-input/1.0.0" },
        "resolution_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "action": { "enum": ["accept_original", "user_correction"] },
        "source_proofread_artifact": {
          "allOf": [
            { "$ref": "#/$defs/artifactRef" },
            { "properties": { "kind": { "const": "ocr-proofread-bundle" } } }
          ]
        },
        "source_item_id": { "type": "string", "minLength": 1 },
        "original_text_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "proofread_text_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "unresolved_candidates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/unresolved" } },
        "reason": { "type": "string", "minLength": 1 },
        "correction": {
          "type": "object",
          "required": ["corrected_text", "corrected_text_sha256", "diffs"],
          "properties": {
            "corrected_text": { "type": "string" },
            "corrected_text_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "diffs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/diff" } }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "accept_original" } }, "required": ["action"] },
          "then": { "not": { "required": ["correction"] } },
          "else": { "required": ["correction"] }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
