{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "language-practice-decision/2.0.0",
  "title": "SHA-bound language target resolution request",
  "type": "object",
  "required": ["schema_version", "decision_bundle_id", "package_id", "task_id", "input_version", "attempt_id", "created_at", "learning_bundle_path", "learning_bundle_sha256", "state", "decisions"],
  "properties": {
    "schema_version": { "const": "language-practice-decision/2.0.0" },
    "decision_bundle_id": { "type": "string", "minLength": 1 },
    "package_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "input_version": { "type": "string", "minLength": 1 },
    "attempt_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "learning_bundle_path": { "type": "string", "minLength": 1 },
    "learning_bundle_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "state": { "const": "requires_human" },
    "decisions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/decision" } }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "required": ["decision_id", "item_id", "unit_id", "category_id", "state", "reasons", "allowed_modes", "requested_override_paths", "source_segment_ids", "target_token", "selected_text_sha256", "target_text_sha256", "context_segment_sha256s", "candidate_positions", "suggested_user_fields"],
      "properties": {
        "decision_id": { "type": "string", "minLength": 1 },
        "item_id": { "type": "string", "minLength": 1 },
        "unit_id": { "type": "string", "minLength": 1 },
        "category_id": { "enum": ["language_zh", "language_en"] },
        "state": { "const": "requires_human" },
        "reasons": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["language_practice_mode_required", "language_writing_target_not_unique", "language_writing_details_required"] } },
        "allowed_modes": { "const": ["meaning-reading", "writing", "both"] },
        "requested_override_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "source_segment_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "target_term": { "type": "string", "minLength": 1 },
        "target_occurrence_count": { "type": "integer", "minimum": 0 },
        "current_mode": { "enum": ["meaning-reading", "writing", "both"] },
        "pronunciation_state": { "enum": ["missing", "unreliable"] },
        "meaning_state": { "enum": ["missing", "unreliable"] },
        "target_token": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "selected_text_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "target_text_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "context_segment_sha256s": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
        "candidate_positions": { "type": "array", "items": { "type": "object", "required": ["segment_id", "order", "start", "end", "exact_text", "source_sha256"], "properties": { "segment_id": { "type": "string" }, "order": { "type": "integer", "minimum": 0 }, "start": { "type": "integer", "minimum": 0 }, "end": { "type": "integer", "minimum": 0 }, "exact_text": { "type": "string", "minLength": 1 }, "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }, "additionalProperties": false } },
        "suggested_user_fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
