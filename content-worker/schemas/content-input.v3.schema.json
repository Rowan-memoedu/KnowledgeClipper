{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standard-input/3.0.0",
  "title": "KnowledgeClipper explicit question workflow input",
  "$comment": "Additive module-local input for question.answer and question.make-cards. Common WorkerRequest remains authoritative for execution.",
  "type": "object",
  "required": ["schema_version", "package_id", "task_id", "input_version", "mode", "questionWorkflow", "items"],
  "properties": {
    "schema_version": { "const": "standard-input/3.0.0" },
    "package_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "input_version": { "type": "string", "minLength": 1 },
    "mode": { "const": "question" },
    "questionWorkflow": {
      "type": "object",
      "required": ["schemaVersion", "phase", "questionTurns", "answerAncestry"],
      "properties": {
        "schemaVersion": { "const": "question-workflow-input/1.0.0" },
        "phase": { "enum": ["answer", "make-cards"] },
        "questionTurns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["turnId", "turnIndex", "question"],
            "properties": {
              "turnId": { "$ref": "#/$defs/identifier" },
              "turnIndex": { "type": "integer", "minimum": 0 },
              "question": { "type": "string", "minLength": 1, "pattern": "\\S" },
              "parentAnswerId": { "$ref": "#/$defs/identifier" }
            },
            "additionalProperties": false
          }
        },
        "answerAncestry": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["answerId", "artifactRef", "turnId", "turnIndex", "questionSha256", "answerText", "answerTextSha256"],
            "properties": {
              "answerId": { "$ref": "#/$defs/identifier" },
              "artifactRef": { "$ref": "#/$defs/identifier" },
              "turnId": { "$ref": "#/$defs/identifier" },
              "turnIndex": { "type": "integer", "minimum": 0 },
              "questionSha256": { "$ref": "#/$defs/sha256" },
              "answerText": { "type": "string", "minLength": 1, "pattern": "\\S" },
              "answerTextSha256": { "$ref": "#/$defs/sha256" },
              "parentAnswerId": { "$ref": "#/$defs/identifier" }
            },
            "additionalProperties": false
          }
        },
        "cardStructureRef": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["item_id", "source"],
        "properties": {
          "item_id": { "type": "string", "minLength": 1 },
          "source": {
            "type": "object",
            "required": ["kind"],
            "properties": { "kind": { "const": "question_workflow" } },
            "additionalProperties": false
          },
          "hints": {
            "type": "object",
            "properties": {
              "requested_templates": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
