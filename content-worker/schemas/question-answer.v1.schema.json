{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "question-answer/1.0.0",
  "title": "KnowledgeClipper destination-neutral question answer artifact",
  "type": "object",
  "required": ["schema_version", "answer_bundle_id", "package_id", "task_id", "input_version", "attempt_id", "created_at", "phase", "learning_bundle_path", "learning_bundle_sha256", "question_chain_sha256", "new_answer_id", "turns", "gates"],
  "properties": {
    "schema_version": { "const": "question-answer/1.0.0" },
    "answer_bundle_id": { "type": "string", "minLength": 1 },
    "package_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "input_version": { "type": "string", "minLength": 1 },
    "attempt_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "phase": { "const": "answer" },
    "learning_bundle_path": { "type": "string", "minLength": 1 },
    "learning_bundle_sha256": { "$ref": "#/$defs/sha256" },
    "question_chain_sha256": { "$ref": "#/$defs/sha256" },
    "new_answer_id": { "$ref": "#/$defs/identifier" },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["answer_id", "artifact_ref", "turn_id", "turn_index", "question", "question_sha256", "answer_text", "answer_text_sha256", "provenance"],
        "properties": {
          "answer_id": { "$ref": "#/$defs/identifier" },
          "artifact_ref": { "$ref": "#/$defs/identifier" },
          "turn_id": { "$ref": "#/$defs/identifier" },
          "turn_index": { "type": "integer", "minimum": 0 },
          "question": { "type": "string", "minLength": 1 },
          "question_sha256": { "$ref": "#/$defs/sha256" },
          "answer_text": { "type": "string", "minLength": 1 },
          "answer_text_sha256": { "$ref": "#/$defs/sha256" },
          "parent_answer_id": { "$ref": "#/$defs/identifier" },
          "provenance": { "enum": ["persisted", "generated"] }
        },
        "additionalProperties": false
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["gate_id", "status", "evidence"],
        "properties": {
          "gate_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "fail", "notice"] },
          "evidence": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
