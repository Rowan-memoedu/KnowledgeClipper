{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standard-input/4.0.0",
  "title": "Content worker module-local OCR-aware input document",
  "$comment": "Additive module-local schema. Common WorkerRequest and Artifact contracts remain unchanged.",
  "type": "object",
  "required": ["schema_version", "package_id", "task_id", "input_version", "mode", "items"],
  "properties": {
    "schema_version": { "const": "standard-input/4.0.0" },
    "package_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "input_version": { "type": "string", "minLength": 1 },
    "mode": { "const": "card" },
    "languagePracticeMode": { "enum": ["meaning-reading", "writing", "both"] },
    "human_overrides": { "type": "object", "additionalProperties": true },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item_id", "source"],
        "properties": {
          "item_id": { "type": "string", "minLength": 1 },
          "source": {
            "oneOf": [
              {
                "type": "object",
                "required": ["kind", "material_path"],
                "properties": {
                  "kind": { "enum": ["text", "conversation"] },
                  "material_path": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["kind", "material_path", "provenance"],
                "properties": {
                  "kind": { "const": "ocr_text" },
                  "material_path": { "type": "string", "minLength": 1 },
                  "provenance": {
                    "type": "object",
                    "required": ["schema_version", "producer_worker_id", "markdown_artifact"],
                    "properties": {
                      "schema_version": { "const": "ocr-provenance/1.0.0" },
                      "producer_worker_id": { "const": "image.ocr.mineru" },
                      "markdown_artifact": { "$ref": "#/$defs/ocrArtifactRef" },
                      "structured_artifact": { "$ref": "#/$defs/ocrArtifactRef" }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["kind", "assets"],
                "properties": {
                  "kind": { "const": "media_set" },
                  "assets": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["material_path", "role"],
                      "properties": {
                        "material_path": { "type": "string", "minLength": 1 },
                        "role": { "enum": ["question", "answer", "context", "unknown"] }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "hints": { "type": "object", "additionalProperties": true },
          "human_overrides": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "ocrArtifactRef": {
      "type": "object",
      "required": ["artifactRef", "kind", "contractVersion", "manifestPath", "expectedSha256", "payload_path", "payload_sha256"],
      "properties": {
        "artifactRef": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["image-ocr.markdown", "image-ocr.structured"] },
        "contractVersion": { "const": "1.0.0" },
        "manifestPath": { "type": "string", "minLength": 1 },
        "expectedSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "payload_path": { "type": "string", "minLength": 1 },
        "payload_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
