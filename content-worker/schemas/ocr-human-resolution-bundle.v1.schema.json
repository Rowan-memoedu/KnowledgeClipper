{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ocr-human-resolution-bundle/1.0.0",
  "type": "object",
  "required": ["schema_version", "bundle_id", "package_id", "task_id", "input_version", "attempt_id", "created_at", "records", "release_state", "gates"],
  "properties": {
    "schema_version": { "const": "ocr-human-resolution-bundle/1.0.0" },
    "bundle_id": { "type": "string", "minLength": 1 },
    "package_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "input_version": { "type": "string", "minLength": 1 },
    "attempt_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "records": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "release_state": { "enum": ["ready", "unresolved"] },
    "gates": { "type": "array" }
  },
  "additionalProperties": false
}
