<Project>
  <PropertyGroup>
    <KnowledgeClipperBuildCache Condition="'$(KnowledgeClipperBuildCache)' == ''">D:\Caches\KnowledgeClipper\build</KnowledgeClipperBuildCache>
    <KnowledgeClipperBuildOutput Condition="'$(KnowledgeClipperBuildOutput)' == ''">D:\Artifacts\KnowledgeClipper\build</KnowledgeClipperBuildOutput>
    <BaseIntermediateOutputPath>$(KnowledgeClipperBuildCache)\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(KnowledgeClipperBuildOutput)\$(MSBuildProjectName)\</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);**\bin\**;**\obj\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
