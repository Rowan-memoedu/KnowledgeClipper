<Project>
  <PropertyGroup>
    <KnowledgeClipperBuildCache Condition="'$(KnowledgeClipperBuildCache)' == ''">D:\Caches\KnowledgeClipper\build</KnowledgeClipperBuildCache>
    <KnowledgeClipperBuildOutput Condition="'$(KnowledgeClipperBuildOutput)' == ''">D:\Artifacts\KnowledgeClipper\build</KnowledgeClipperBuildOutput>
    <BaseIntermediateOutputPath>$(KnowledgeClipperBuildCache)\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(KnowledgeClipperBuildOutput)\$(MSBuildProjectName)\</BaseOutputPath>
    <!--
      Each desktop project has its own output subtree under desktop/bin.  The
      SDK's computed default excludes only cover the active project's output
      path, so assemblies left by a sibling can otherwise be treated as
      CandidateAssemblyFiles and win over an explicit frozen-SDK HintPath.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildThisFileDirectory)bin\**;$(MSBuildThisFileDirectory)obj\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
