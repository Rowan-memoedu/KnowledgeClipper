<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>KnowledgeClipper</AssemblyName>
    <RootNamespace>KnowledgeClipper</RootNamespace>
    <Product>零碎知识剪藏</Product>
    <AssemblyTitle>零碎知识剪藏</AssemblyTitle>
    <Description>桌面知识采集、处理与多目标导出工具</Description>
    <Company>零碎知识剪藏</Company>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\licenses\Markdig.txt" Link="licenses\Markdig.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)\microsoft.web.webview2\1.0.4258.31\LICENSE.txt" Link="licenses\Microsoft.Web.WebView2.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(NuGetPackageRoot)\microsoft.web.webview2\1.0.4258.31\NOTICE.txt" Link="licenses\Microsoft.Web.WebView2-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\src\Core.cs" Link="Core.cs" />
    <Compile Include="..\src\DesktopSettingsDomain.cs" Link="DesktopSettingsDomain.cs" />
    <Compile Include="..\src\Program.cs" Link="Program.cs" />
    <Compile Include="..\src\ProjectSettingsForm.cs" Link="ProjectSettingsForm.cs" />
    <Compile Include="..\src\ProjectSettingsForm.RemNote.cs" Link="ProjectSettingsForm.RemNote.cs" />
    <Compile Include="..\src\DesktopDestinationSettingsPublisher.cs" Link="DesktopDestinationSettingsPublisher.cs" />
    <Compile Include="..\src\DesktopCredentialSettings.cs" Link="DesktopCredentialSettings.cs" />
    <Compile Include="..\src\DesktopSettingsControl.cs" Link="DesktopSettingsControl.cs" />
    <Compile Include="..\src\DesktopModuleSettings.cs" Link="DesktopModuleSettings.cs" />
    <Compile Include="..\src\DesktopApplication.cs" Link="DesktopApplication.cs" />
    <Compile Include="..\src\LegacyDesktopAdapter.cs" Link="LegacyDesktopAdapter.cs" />
    <Compile Include="..\src\SingleInstanceCoordinator.cs" Link="SingleInstanceCoordinator.cs" />
    <Compile Include="..\src\CandidateIntegration.cs" Link="CandidateIntegration.cs" />
    <Compile Include="..\src\CandidateReadToAnkiProcessCanary.cs" Link="CandidateReadToAnkiProcessCanary.cs" />
    <Compile Include="..\src\LoopbackProviderOverrides.cs" Link="LoopbackProviderOverrides.cs" />
    <Compile Include="..\src\StartupDiagnostics.cs" Link="StartupDiagnostics.cs" />
    <Compile Include="..\src\DesktopUi.cs" Link="DesktopUi.cs" />
    <Compile Include="..\src\DesktopUi.Language.cs" Link="DesktopUi.Language.cs" />
    <Compile Include="..\src\ClipboardImageMonitor.cs" Link="ClipboardImageMonitor.cs" />
    <Compile Include="..\src\Language*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="..\src\Excerpt*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="..\src\Image*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="..\src\RecordHistory*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="..\src\MeaningPopup.cs" Link="MeaningPopup.cs" />
    <Compile Include="..\src\FlashcardPreviewUi.cs" Link="FlashcardPreviewUi.cs" />
    <Compile Include="..\src\CardResolutionUi.cs" Link="CardResolutionUi.cs" />
    <Compile Include="..\src\WindowsDesktopProviders.cs" Link="WindowsDesktopProviders.cs" />
    <Compile Include="..\src\KnowledgeClipper.Desktop.Application\*.cs" Link="Desktop.Application\%(Filename)%(Extension)" />
    <Compile Include="..\src\KnowledgeClipper.Desktop.Adapters\*.cs" Link="Desktop.Adapters\%(Filename)%(Extension)" />
    <Compile Include="..\src\Compat\JavaScriptSerializer.Net8.cs" Link="Compat\JavaScriptSerializer.Net8.cs" />
    <Compile Include="..\src\RemNoteQuickClipper.Desktop.Core\*.cs" Exclude="..\src\RemNoteQuickClipper.Desktop.Core\SemanticPortProgram.cs;..\src\RemNoteQuickClipper.Desktop.Core\SemanticPortProgramV11.cs" Link="Desktop.Core\%(Filename)%(Extension)" />
    <Content Include="..\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\contracts\core\v2.4\settings-control\**\*" Link="contracts\core\v2.4\settings-control\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\contracts\remnote-destination-settings.v1.schema.json" Link="contracts\remnote-destination-settings.v1.schema.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\contracts\remnote-destination-settings-snapshot.v1.schema.json" Link="contracts\remnote-destination-settings-snapshot.v1.schema.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\contracts\remnote-export-payload.v2.schema.json" Link="contracts\remnote-export-payload.v2.schema.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\contracts\core\v2.5\checkpoints\v2.5.1-20260830T075400Z\checkpoint.json" Link="contracts\core\v2.5\checkpoints\v2.5.1-20260830T075400Z\checkpoint.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\contracts\core\v2.1\profile-resolver.v2.1.json" Link="contracts\core\v2.1\profile-resolver.v2.1.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\contracts\desktop-automation\**\*" Link="contracts\desktop-automation\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\contracts\v1\**\*" Link="contracts\v1\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\contracts\v1\checkpoints\contracts-v1-stable-checkpoint-20260825T115938Z.json" Link="receipts\contracts-v1-stable-checkpoint-20260825T115938Z.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\workers\image-ocr\candidates\1.2.2\image-ocr-capability-config-descriptor.v4.json" Link="descriptors\image-ocr-capability-config-descriptor.v4.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\workers\image-ocr\candidates\1.2.3\image-ocr-capability-config-descriptor.v5.json" Link="descriptors\image-ocr-capability-config-descriptor.v5.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\core-v3\src\KnowledgeClipper.Core.V3.Client\KnowledgeClipper.Core.V3.Client.csproj" />
    <ProjectReference Include="..\workflow\KnowledgeClipper.Workflow.csproj" />
    <Content Include="..\modes\**\*" Link="modes\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(KnowledgeClipperChatOutput)\**\*" Link="chat-view\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="'$(KnowledgeClipperChatOutput)' != ''" />
    <Content Include="..\helpers\**\*" Exclude="..\helpers\node_modules\.package-lock.json" Link="helpers\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
</Project>
