{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledgeclipper://speech/settings-companion/probe-input/v1",
  "title": "Speech settings companion offline probe input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scope", "effectiveAt", "action", "probeText", "adapterInput"],
  "properties": {
    "schemaVersion": { "const": "speech-settings-companion-probe-input.v1" },
    "scope": { "const": "project" },
    "effectiveAt": { "const": "next_task" },
    "action": { "const": "validate_only" },
    "probeText": { "type": "string", "minLength": 1 },
    "adapterInput": {
      "type": "object",
      "required": ["schemaVersion", "settings", "catalog", "deployment", "synthesisRequest", "playbackRequest"],
      "properties": {
        "schemaVersion": { "const": "speech-settings-adapter-input.v1" },
        "settings": { "type": "object" },
        "catalog": { "type": "object" },
        "deployment": { "type": "object" },
        "synthesisRequest": { "type": "object" },
        "playbackRequest": { "type": "object" }
      }
    }
  }
}
