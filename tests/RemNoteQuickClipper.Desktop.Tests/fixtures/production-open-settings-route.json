{
  "schemaVersion": "knowledge-clipper-native-ui-scenario.v1",
  "journey": "desktop-production-open-settings-route",
  "windowTimeoutMs": 30000,
  "steps": [
    {
      "id": "wait-anki-probe",
      "operation": "wait",
      "automationId": "knowledge-clipper.desktop.settings.export.anki.probe-readonly"
    },
    {
      "id": "cancel-settings",
      "operation": "invoke",
      "automationId": "knowledge-clipper.desktop.settings.cancel",
      "waitAfterMs": 300
    },
    {
      "id": "close-floating-window",
      "operation": "close-window"
    }
  ]
}
