{
  "schemaVersion": "knowledge-clipper-native-ui-scenario.v1",
  "journey": "anki",
  "windowTimeoutMs": 30000,
  "steps": [
    { "id": "focus-navigation", "operation": "focus", "automationId": "knowledge-clipper.desktop.settings.navigation" },
    { "id": "open-export-page", "operation": "send-keys", "automationId": "knowledge-clipper.desktop.settings.navigation", "keys": "{END}{UP}", "waitAfterMs": 500 },
    { "id": "wait-probe", "operation": "wait", "automationId": "knowledge-clipper.desktop.settings.export.anki.probe-readonly" },
    { "id": "invoke-probe", "operation": "invoke", "automationId": "knowledge-clipper.desktop.settings.export.anki.probe-readonly", "waitAfterMs": 500 },
    { "id": "read-status", "operation": "assert-contains", "automationId": "knowledge-clipper.desktop.settings.export.anki.probe-status", "expected": "writes=0", "timeoutMs": 60000 },
    { "id": "close", "operation": "close-window" }
  ]
}
