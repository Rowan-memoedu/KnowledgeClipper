<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="KnowledgeClipper"><HintPath>$(DesktopReleaseDir)\KnowledgeClipper.dll</HintPath></Reference>
    <Reference Include="KnowledgeClipper.Workflow"><HintPath>$(DesktopReleaseDir)\KnowledgeClipper.Workflow.dll</HintPath></Reference>
    <Content Include="$(DesktopReleaseDir)\*.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
