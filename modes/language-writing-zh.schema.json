{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "knowledge-clipper/language-writing-zh/2026-09-11",
  "title": "language-writing-zh",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "pronunciation",
    "generatedSentence",
    "generatedTargetStart",
    "unresolvedReasons",
    "meaning"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "unresolved"
      ]
    },
    "pronunciation": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "\\S"
    },
    "generatedSentence": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "\\S"
    },
    "generatedTargetStart": {
      "type": "null"
    },
    "unresolvedReasons": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "meaning": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "\\S"
    }
  },
  "oneOf": [
    {
      "properties": {
        "status": {
          "enum": [
            "ready"
          ]
        },
        "pronunciation": {
          "type": "string",
          "pattern": "\\S"
        },
        "unresolvedReasons": {
          "maxItems": 0
        },
        "meaning": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    {
      "properties": {
        "status": {
          "enum": [
            "unresolved"
          ]
        },
        "unresolvedReasons": {
          "minItems": 1
        },
        "pronunciation": {
          "type": "null"
        },
        "generatedSentence": {
          "type": "null"
        },
        "generatedTargetStart": {
          "type": "null"
        },
        "meaning": {
          "type": "null"
        }
      }
    }
  ]
}
