{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./anki-destination-settings-descriptor.v1.3.schema.json",
  "title": "KnowledgeClipper Anki destination settings descriptor v1.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "descriptorVersion", "destinationId", "displayName", "optional", "supportsMultipleInstances", "instanceModel", "enablement", "workerBinding", "configBinding", "fields", "capabilities", "operations", "tests", "statusOutputs", "secretRefs"],
  "properties": {
    "schemaVersion": {"const": "knowledge-clipper.destination-settings-descriptor.v1"},
    "descriptorVersion": {"const": "1.3.0"},
    "destinationId": {"const": "anki"},
    "displayName": {"const": "Anki"},
    "optional": {"const": true},
    "supportsMultipleInstances": {"const": false},
    "instanceModel": {"type": "object"},
    "enablement": {"type": "object"},
    "workerBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["workerId", "minimumVersion"],
      "properties": {"workerId": {"const": "export.anki"}, "minimumVersion": {"const": "1.4.0"}}
    },
    "configBinding": {"type": "object"},
    "fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/field"}},
    "capabilities": {
      "type": "object", "additionalProperties": false,
      "required": ["destinationPeer", "media", "provisioning", "fixedSemantics"],
      "properties": {
        "destinationPeer": {"const": true},
        "media": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "activePolicy", "destinationPolicy", "requiresCoreInputContract", "realCanaryStatus"],
          "properties": {
            "status": {"const": "ready"},
            "activePolicy": {"const": "ordered-original-images.v1"},
            "destinationPolicy": {"const": "anki-only"},
            "requiresCoreInputContract": {"const": true},
            "realCanaryStatus": {"const": "worker-fake-readback-pass-core-admission-pending"}
          }
        },
        "provisioning": {
          "type": "object", "additionalProperties": false,
          "required": ["default", "operation", "requiresExplicitExternalWriteAction", "createsOnlyMissingManagedModelsAndDecks", "modifiesExistingResources", "automaticRetryAfterUnknownState"],
          "properties": {
            "default": {"const": false},
            "operation": {"const": "initialize-managed"},
            "requiresExplicitExternalWriteAction": {"const": true},
            "createsOnlyMissingManagedModelsAndDecks": {"const": true},
            "modifiesExistingResources": {"const": false},
            "automaticRetryAfterUnknownState": {"const": false}
          }
        },
        "fixedSemantics": {"type": "array", "items": {"type": "string"}}
      }
    },
    "operations": {
      "type": "object", "additionalProperties": false,
      "required": ["validate", "probe", "export", "initializeManaged"],
      "properties": {
        "validate": {"$ref": "#/$defs/operation"},
        "probe": {"$ref": "#/$defs/operation"},
        "export": {"$ref": "#/$defs/operation"},
        "initializeManaged": {
          "allOf": [
            {"$ref": "#/$defs/operation"},
            {"properties": {"operation": {"const": "initialize-managed"}, "effectClass": {"const": "provider-write"}, "externalMutation": {"const": true}, "workerOperation": {"const": true}}}
          ]
        }
      }
    },
    "tests": {
      "type": "object", "additionalProperties": false,
      "required": ["validateConfiguration", "probeConnection", "initializeManaged"],
      "properties": {
        "validateConfiguration": {"$ref": "#/$defs/testAction"},
        "probeConnection": {"$ref": "#/$defs/testAction"},
        "initializeManaged": {"$ref": "#/$defs/testAction"}
      }
    },
    "statusOutputs": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "schemaVersion", "dataClass", "redaction"],
        "properties": {
          "kind": {"enum": ["anki-connection-status", "anki-managed-initialization-status"]},
          "schemaVersion": {"enum": ["anki-connection-status.v1", "anki-managed-initialization-status.v1"]},
          "dataClass": {"const": "personal"},
          "redaction": {"const": "sha256-profile-model-deck-identifiers"}
        }
      }
    },
    "secretRefs": {"const": []}
  },
  "$defs": {
    "field": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "tier", "authority", "valueType", "required", "default", "secretRefAllowed", "activation", "taskMapping", "restartRequired"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "tier": {"enum": ["common", "advanced", "diagnostic"]},
        "authority": {"enum": ["user", "deployment", "readonly"]},
        "valueType": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "default": {},
        "secretRefAllowed": {"const": false},
        "activation": {"enum": ["next-task", "immediate-readonly", "migration-required", "explicit-initialization-action"]},
        "taskMapping": {"type": ["string", "null"]},
        "restartRequired": {"const": false}
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "effectClass", "networkScope", "externalMutation", "localArtifactWrite", "mayPromptUser", "allowedActions", "workerOperation"],
      "properties": {
        "operation": {"enum": ["validate", "probe", "export", "initialize-managed"]},
        "effectClass": {"enum": ["local-read-only", "provider-read-only", "provider-write"]},
        "networkScope": {"enum": ["none", "loopback-only"]},
        "externalMutation": {"type": "boolean"},
        "localArtifactWrite": {"const": true},
        "mayPromptUser": {"type": "boolean"},
        "allowedActions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "workerOperation": {"const": true}
      }
    },
    "testAction": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "effectClass", "providerInteraction", "externalMutation", "localArtifactWrite", "mayPromptUser", "executionPolicy"],
      "properties": {
        "operation": {"enum": ["validate", "probe", "initialize-managed"]},
        "effectClass": {"enum": ["local-read-only", "provider-read-only", "provider-write"]},
        "providerInteraction": {"enum": ["none", "loopback-read-only", "loopback-write"]},
        "externalMutation": {"type": "boolean"},
        "localArtifactWrite": {"const": true},
        "mayPromptUser": {"type": "boolean"},
        "executionPolicy": {"enum": ["automatic-safe", "explicit-user-action"]}
      }
    }
  }
}
