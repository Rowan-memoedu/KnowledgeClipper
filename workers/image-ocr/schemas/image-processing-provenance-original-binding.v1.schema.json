{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "image-processing-provenance-original-binding.v1.schema.json",
  "title": "OCR provenance same-result original artifact binding profile",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "mode", "terminalStatus", "sourceOrder", "items", "continuation"],
  "properties": {
    "schemaVersion": {"const": "image-processing-provenance.v1"},
    "mode": {"const": "ocr_mineru"},
    "terminalStatus": {"enum": ["completed", "partial"]},
    "sourceOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionImages", "answerImages"],
      "properties": {
        "questionImages": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "answerImages": {"type": "array", "items": {"type": "string"}}
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifactRef", "role", "groupIndex", "imageIndex", "representations"],
        "properties": {
          "artifactRef": {"type": "string", "minLength": 1},
          "role": {"enum": ["question", "answer"]},
          "groupIndex": {"type": "integer", "minimum": 0},
          "imageIndex": {"type": "integer", "minimum": 0},
          "representations": {
            "type": "object",
            "required": ["original"],
            "properties": {
              "original": {
                "type": "object",
                "additionalProperties": false,
                "required": ["artifactRef", "sha256", "bytes", "mediaType"],
                "properties": {
                  "artifactRef": {"type": "string", "minLength": 1},
                  "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "bytes": {"type": "integer", "minimum": 1},
                  "mediaType": {"type": "string", "pattern": "^image/"}
                }
              }
            }
          }
        }
      }
    },
    "continuation": {
      "type": "object",
      "required": ["defaultOcrRerun", "requiresOriginalArtifactHashMatch", "requiresSuccessfulOutputHashMatch"],
      "properties": {
        "defaultOcrRerun": {"const": false},
        "requiresOriginalArtifactHashMatch": {"const": true},
        "requiresSuccessfulOutputHashMatch": {"const": true}
      }
    }
  }
}
