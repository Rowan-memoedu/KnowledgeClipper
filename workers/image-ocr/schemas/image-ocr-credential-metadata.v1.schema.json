{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "image-ocr-credential-metadata.v1.schema.json",
  "title": "KnowledgeClipper Image/OCR value-free credential metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "credentialId", "configured", "verified", "sourceType"],
  "properties": {
    "schemaVersion": {"const": "image-ocr-credential-metadata.v1"},
    "credentialId": {"const": "local-credential://image-ocr/mineru-api-token"},
    "configured": {"type": "boolean"},
    "verified": {"type": "boolean"},
    "sourceType": {
      "enum": [
        "desktop-dpapi-current-user",
        "desktop-dpapi-current-user-backup",
        "desktop-dpapi-current-user-migrated",
        "not-probed",
        "not-configured"
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"verified": {"const": true}}},
      "then": {
        "properties": {
          "configured": {"const": true},
          "sourceType": {"pattern": "^desktop-dpapi-"}
        }
      }
    }
  ]
}
