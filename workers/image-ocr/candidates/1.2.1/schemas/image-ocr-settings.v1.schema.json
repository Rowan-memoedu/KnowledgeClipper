{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "image-ocr-settings.v1.schema.json",
  "title": "KnowledgeClipper image/OCR project settings v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode"],
  "properties": {
    "schemaVersion": {"const": "image-ocr-settings.v1"},
    "mode": {"enum": ["ocr", "original"]},
    "providerSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelVersion": {"enum": ["vlm", "pipeline", "MinerU-HTML"]},
        "language": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$"},
        "enableTable": {"type": "boolean"},
        "enableFormula": {"type": "boolean"},
        "timeoutSeconds": {"type": "integer", "minimum": 30, "maximum": 3600},
        "pollIntervalSeconds": {"type": "integer", "minimum": 1, "maximum": 60}
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mineruScriptPath": {"type": "string", "minLength": 1}
      }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mineruTokenRef": {
          "type": "string",
          "pattern": "^local-credential://[A-Za-z0-9][A-Za-z0-9._/-]{0,223}$"
        }
      }
    }
  }
}
