{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "image-processing-provenance.v1.schema.json",
  "title": "Image original, Markdown, and structured representation provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "captureId", "operationId", "attemptId", "mode", "terminalStatus", "provider", "sourceOrder", "items", "continuation"],
  "properties": {
    "schemaVersion": {"const": "image-processing-provenance.v1"},
    "captureId": {"type": "string", "minLength": 1},
    "operationId": {"type": "string", "minLength": 1},
    "attemptId": {"type": "string", "minLength": 1},
    "mode": {"enum": ["ocr_mineru", "original_passthrough"]},
    "terminalStatus": {"enum": ["completed", "partial", "failed"]},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "calls", "cloudUploadAuthorized"],
      "properties": {
        "id": {"type": ["string", "null"]},
        "calls": {"type": "integer", "minimum": 0},
        "cloudUploadAuthorized": {"type": "boolean"}
      }
    },
    "sourceOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionImages", "answerImages"],
      "properties": {
        "questionImages": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "answerImages": {"type": "array", "items": {"type": "string"}}
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactRef", "role", "groupIndex", "imageIndex", "status", "reusedFromAttempt", "representations", "error"],
        "properties": {
          "artifactRef": {"type": "string"},
          "role": {"enum": ["question", "answer"]},
          "groupIndex": {"type": "integer", "minimum": 0},
          "imageIndex": {"type": "integer", "minimum": 0},
          "status": {"enum": ["completed", "failed"]},
          "reusedFromAttempt": {"type": ["string", "null"]},
          "representations": {"type": "object"},
          "error": {"type": ["object", "null"]}
        }
      }
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["humanJudgmentAvailable", "automaticDownstreamAllowed", "partialBlocksDownstream", "defaultOcrRerun", "humanActions", "requiresOriginalArtifactHashMatch", "requiresSuccessfulOutputHashMatch", "retryScope", "failedArtifactRefs", "reusableCompletedArtifactRefs"],
      "properties": {
        "humanJudgmentAvailable": {"type": "boolean"},
        "automaticDownstreamAllowed": {"type": "boolean"},
        "partialBlocksDownstream": {"const": true},
        "defaultOcrRerun": {"const": false},
        "humanActions": {"const": ["accept", "correct"]},
        "requiresOriginalArtifactHashMatch": {"const": true},
        "requiresSuccessfulOutputHashMatch": {"const": true},
        "retryScope": {"enum": ["none", "failed-items-only"]},
        "failedArtifactRefs": {"type": "array", "items": {"type": "string"}},
        "reusableCompletedArtifactRefs": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
